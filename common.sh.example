# Copy to ./common.sh or ~/.config/pie/common.sh (or point PIE_ENV_FILE at it) and fill it in.
# Every pie command loads it; variables already set in the environment win.
# Values are literal: no $VAR or ~ expansion and no inline comments; single-quote a value with spaces.
WANDB_ENTITY=
WANDB_PROJECT=
PIE_DATA_ROOT=
PIE_RUNS_ROOT=
PIE_CACHE_DIR=
